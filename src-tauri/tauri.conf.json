{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LockCord",
  "version": "1.6.0",
  "identifier": "chat.lockcord.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: http://lcmedia.localhost lcmedia:",
        "media-src": "'self' blob: http://lcmedia.localhost lcmedia:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://ecdh.chat wss://ecdh.chat",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "publisher": "LockCord",
    "category": "SocialNetworking",
    "shortDescription": "A small, privacy-first Discord client",
    "copyright": "© 2026 LockCord contributors, GPL-3.0",
    "licenseFile": "../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
