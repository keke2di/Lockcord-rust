{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "LockCord's own window: our commands and events only. The login and captcha windows get nothing.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-status",
    "allow-sign-in",
    "allow-sign-in-with-token",
    "allow-sign-out",
    "allow-messages",
    "allow-send-message",
    "allow-edit-message",
    "allow-delete-message",
    "allow-react",
    "allow-typing",
    "allow-upload-attachment",
    "allow-ack",
    "allow-relationship",
    "allow-open-dm",
    "allow-subscribe",
    "allow-settings-get",
    "allow-settings-save",
    "allow-theme-get",
    "allow-theme-save",
    "allow-theme-delete",
    "allow-theme-asset-add",
    "allow-theme-asset-remove",
    "allow-theme-import",
    "allow-theme-export",
    "allow-purge-scan",
    "allow-purge-run",
    "allow-purge-stop",
    "allow-guard-list",
    "allow-guard-set",
    "allow-guard-remove",
    "allow-translate-texts",
    "allow-translate-outgoing",
    "allow-e2e-status",
    "allow-e2e-enable",
    "allow-e2e-accept-change",
    "allow-e2e-verify",
    "allow-e2e-forget",
    "allow-viewing",
    "allow-save-folder",
    "allow-pick-save-folder",
    "allow-save-media",
    "allow-open-link",
    "allow-add-friend",
    "allow-user-profile",
    "allow-set-status",
    "allow-create-group",
    "allow-group-add",
    "allow-group-leave",
    "allow-pins",
    "allow-pin",
    "allow-threads",
    "allow-thread-join",
    "allow-forum-posts",
    "allow-poll-vote",
    "allow-search",
    "allow-thread-open"
  ]
}
